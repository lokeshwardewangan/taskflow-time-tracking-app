PORT=5000
LOG_LEVEL=info
NODE_ENV=development

FRONTEND_URL=http://localhost:5173
# Local server connecting to Compose's database; Compose overrides the host to postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timeflow
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/timeflow

JWT_SECRET=my-super-secret-key-my-super-secret-key

# Optional AI suggestions (server only). Enable locally after adding your key.
AI_ENABLED=false
OPENAI_API_KEY=key
