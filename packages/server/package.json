{
   "name": "server",
   "module": "index.ts",
   "type": "module",
   "private": true,
   "engines": {
      "node": "22.x"
   },
   "scripts": {
      "start": "bun ./dist/index.js",
      "dev": "bun --watch src/index.ts",
      "build": "prisma generate && bun build ./src/index.ts --outdir ./dist --target bun --packages external",
      "postinstall": "bunx prisma generate",
      "check": "tsc --noEmit",
      "test": "vitest",
      "studio": "bunx prisma studio"
   },
   "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/bun": "latest",
      "@types/cookie-parser": "^1.4.10",
      "@types/express": "^5.0.6",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/pg": "^8.23.1",
      "prisma": "^7.10.0",
      "vitest": "^5.0.1"
   },
   "peerDependencies": {
      "typescript": "^5"
   },
   "dependencies": {
      "@prisma/adapter-pg": "^7.10.0",
      "@prisma/client": "7",
      "@types/cors": "^2.8.19",
      "bcrypt": "^6.0.0",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.6",
      "dotenv": "^18.0.1",
      "express": "^5.2.1",
      "jsonwebtoken": "^9.0.3",
      "pg": "^8.23.0",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "zod": "^4.6.5"
   }
}
